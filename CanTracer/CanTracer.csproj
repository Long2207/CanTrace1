<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
	<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>  
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CanTracer</RootNamespace>
    <AssemblyName>CanTracer</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>

    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <Product>CanTracer</Product>
    <Description>Multi-Bus CAN/CANFD Monitor (PEAK + Vector) with testcase system</Description>
  </PropertyGroup>

  <!-- Self-contained single-file publish defaults (only on 'dotnet publish') -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.49.1" />
  </ItemGroup>

  <!-- Vector XL Driver .NET wrapper. Adjust the HintPath to your install. -->
  <ItemGroup>
    <Reference Include="vxlapi_NET">
      <HintPath>C:\Users\Public\Documents\Vector\XL Driver Library 20.30.14\bin\vxlapi_NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- PCANBasic.dll copied next to the exe on build/publish -->
  <ItemGroup>
    <None Update="PCANBasic.dll" Condition="Exists('PCANBasic.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
