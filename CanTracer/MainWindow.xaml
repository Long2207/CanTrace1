<Window x:Class="CanTracer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="CanTracer — Multi-Bus CAN/CANFD Monitor"
        Height="780" Width="1480"
        FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen"
        Closed="OnWindowClosed">

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin"  Value="2,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin"  Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="#FFF0F0F0" Padding="6"
                BorderThickness="0,0,0,1" BorderBrush="#FFCCCCCC">
            <StackPanel Orientation="Horizontal">
                <Button Content="🍌 Settings…" Style="{StaticResource ToolButton}"
                        Background="#FFFFF8E1" Command="{Binding OpenSettingsCommand}"/>
                <Separator Margin="6,0"/>
                <Button Content="Send by signal…" Style="{StaticResource ToolButton}"
                        Command="{Binding SendByDbcCommand}"/>
                <Separator Margin="6,0"/>

                <!-- Record toggle -->
                <Button Content="{Binding RecordButtonText}"
                        Command="{Binding ToggleRecordCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                            <Setter Property="Background" Value="#FFFBE9E7"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Background" Value="#FFEF5350"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="📂 Open Logs" Style="{StaticResource ToolButton}"
                        Command="{Binding OpenLogsFolderCommand}"
                        ToolTip="Open the Logs folder next to the executable"/>

                <Separator Margin="6,0"/>
                <Button Content="Clear"        Style="{StaticResource ToolButton}" Command="{Binding ClearCommand}"/>
                <Button Content="Reset counts" Style="{StaticResource ToolButton}" Command="{Binding ResetCountsCommand}"/>
                <Button Content="Export CSV"   Style="{StaticResource ToolButton}" Command="{Binding ExportCsvCommand}"/>
                <Separator Margin="6,0"/>
                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
                <TextBox Width="240" VerticalAlignment="Center" FontSize="13"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by Name, ID hex, or Bus"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#FFE6E6E6" Padding="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Buses: "/>
                <TextBlock Text="{Binding Buses.Count}" FontWeight="Bold"/>
                <TextBlock Text="   |   Messages: "/>
                <TextBlock Text="{Binding UniqueMessages}" FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="   |   "/>
                    <TextBlock Text="🔴 REC " Foreground="Red" FontWeight="Bold"/>
                    <TextBlock Text="{Binding RecordFrameCount}"/>
                    <TextBlock Text=" frames"/>
                </StackPanel>

                <TextBlock Text="   |   "/>
                <TextBlock Text="{Binding Status}"/>
            </StackPanel>
        </Border>

        <!-- Main grid -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT sidebar -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Border DockPanel.Dock="Top" Background="#FFE6E6E6" Padding="6">
                        <DockPanel>
                            <TextBlock Text="TESTCASES" FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="↻" Padding="6,0" Margin="0,0,4,0"
                                        ToolTip="Refresh testcase list"
                                        Command="{Binding RefreshTestCasesCommand}"/>
                                <Button Content="📁" Padding="6,0" Margin="0,0,4,0"
                                        ToolTip="Open TestCases folder"
                                        Command="{Binding OpenTestCasesFolderCommand}"/>
                                <Button Content="+ New" Padding="6,0"
                                        ToolTip="Create a new testcase"
                                        Command="{Binding NewTestCaseCommand}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Fire/stop bar for the loaded testcase -->
                    <Border DockPanel.Dock="Bottom" Background="#FFF5F5F5" Padding="6"
                            BorderThickness="0,1,0,0" BorderBrush="#FFD0D0D0">
                        <StackPanel>
                            <TextBlock Text="{Binding LoadedTestCaseName}" FontWeight="Bold"
                                       FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TestCaseStatus}" FontSize="10"
                                       Foreground="#FF666666" TextWrapping="Wrap" Margin="0,2,0,4"/>
                            <DockPanel>
                                <Button Content="{Binding FireButtonText}" DockPanel.Dock="Left"
                                        Padding="10,4" Command="{Binding FireTestCaseCommand}"/>
                                <Button Content="✎ Edit" DockPanel.Dock="Right" Padding="10,4"
                                        Command="{Binding EditTestCaseCommand}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Padding="12,20" TextWrapping="Wrap"
                               Foreground="Gray" FontStyle="Italic" TextAlignment="Center"
                               Text="No testcases yet. Click + New to create one, or drop .mtc files into the TestCases folder.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestCases.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TestCases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="6,6,6,0" Padding="8" CornerRadius="4"
                                            BorderThickness="1" BorderBrush="#FFD0D0D0"
                                            Background="White">
                                        <DockPanel>
                                            <TextBlock Text="📄" DockPanel.Dock="Left"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Content="▶" DockPanel.Dock="Right" Padding="8,2"
                                                    ToolTip="Load this testcase (then Fire below)"
                                                    Command="{Binding DataContext.OpenTestCaseCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding RelativeFolder}" FontSize="10"
                                                           Foreground="#FF999999"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Cyclic jobs panel -->
                <Border x:Name="CyclicPanel" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#FFD0D0D0"
                        Background="#FFFAFAFA" MaxHeight="200" Visibility="Collapsed">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#FFE6E6E6" Padding="6">
                            <TextBlock Text="CYCLIC JOBS" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <ItemsControl x:Name="CyclicJobsView">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,3" Margin="6,4,6,0" Background="White"
                                            BorderThickness="1" BorderBrush="#FFD0D0D0" CornerRadius="3">
                                        <DockPanel>
                                            <Button Content="■" Padding="6,0" Margin="0,0,6,0"
                                                    DockPanel.Dock="Right"
                                                    Foreground="#FFB00020" FontWeight="Bold"
                                                    Background="Transparent" BorderThickness="0"
                                                    Command="{Binding DataContext.StopCyclicCommand, ElementName=Root}"
                                                    CommandParameter="{Binding Id}"/>
                                            <StackPanel>
                                                <TextBlock FontFamily="Consolas" FontSize="11">
                                                    <Run Text="{Binding MessageName, Mode=OneWay}" FontWeight="Bold"/>
                                                    <Run Text=" → "/>
                                                    <Run Text="{Binding Bus.Name, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="#FF777777">
                                                    <Run Text="ID=0x"/><Run Text="{Binding CanId, Mode=OneWay, StringFormat=X}"/>
                                                    <Run Text=" · every "/><Run Text="{Binding PeriodMs, Mode=OneWay}"/><Run Text=" ms"/>
                                                    <Run Text=" · sent "/><Run Text="{Binding SentCount, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#FFD0D0D0"/>

            <!-- RIGHT: messages grid -->
            <!-- RIGHT: send messenger panel (top) + trace grid (bottom) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Send Messenger: shown when a testcase is loaded -->
                <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="#FFB0B0B0"
                        Background="#FFF7FBFF" MaxHeight="320"
                        Visibility="{Binding ShowSendPanel, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="6">
                        <DockPanel DockPanel.Dock="Top" Margin="2,2,2,6">
                            <Button DockPanel.Dock="Right" Content="+ Add message" Padding="10,2"
                                    Command="{Binding AddSendMessageCommand}"
                                    ToolTip="Add a message (by ID/name or from DBC)"/>
                            <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                                       Text="{Binding LoadedTestCaseName, Mode=OneWay, StringFormat='Send Messenger — {0}'}"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding SendMessages}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="All"
                                  RowHeaderWidth="0" FontSize="12"
                                  RowDetailsVisibilityMode="VisibleWhenSelected"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"   Binding="{Binding ID}"   Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Cycle(ms)" Binding="{Binding CycleTime}" Width="80"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Padding="4,0" Background="Transparent"
                                                    BorderThickness="0" Foreground="#FFB00020" FontWeight="Bold"
                                                    ToolTip="Remove this message from the testcase"
                                                    Command="{Binding DataContext.RemoveSendMessageCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <!-- Signals of the selected message, with decode + dropdown -->
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border Background="#FFEFF6FF" Padding="8,6" Margin="20,2,6,4"
                                            BorderBrush="#FFB8D0F0" BorderThickness="1" CornerRadius="3">
                                        <DataGrid ItemsSource="{Binding Signals}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                  RowHeaderWidth="0" Background="White" FontSize="12"
                                                  MaxHeight="240">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Signal" Binding="{Binding Name}"
                                                                    Width="260" IsReadOnly="True"/>
                                                <!-- Editable value: dropdown when value table exists -->
                                                <DataGridTemplateColumn Header="Value" Width="200">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <ComboBox ItemsSource="{Binding Choices}"
                                                                          Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                          IsEditable="True"
                                                                          Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasChoices}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Decoded" Binding="{Binding DecodedLabel}"
                                                                    Width="*" IsReadOnly="True"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- RIGHT: messages grid -->
                <DataGrid Grid.Row="1"
                      ItemsSource="{Binding MessagesView}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      CanUserSortColumns="True"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      FontFamily="Consolas" FontSize="12"
                      AlternatingRowBackground="#FFFAFAFA">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Bus" Width="80" SortMemberPath="BusName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BusColor}" CornerRadius="3"
                                        Padding="6,1" Margin="2" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding BusName}" Foreground="White"
                                               FontWeight="Bold" FontSize="11"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ID"    Binding="{Binding IdHex}"      Width="80" SortMemberPath="Id"/>
                    <DataGridTextColumn Header="Name"  Binding="{Binding Name}"       Width="220"/>
                    <DataGridTextColumn Header="Type"  Binding="{Binding EventType}"  Width="100"/>
                    <DataGridTextColumn Header="Dir"   Binding="{Binding Direction}"  Width="40"/>
                    <DataGridTextColumn Header="DLC"   Binding="{Binding Dlc}"        Width="40"/>
                    <DataGridTextColumn Header="Len"   Binding="{Binding DataLength}" Width="40"/>
                    <DataGridTextColumn Header="Data"  Binding="{Binding DataHex}"    Width="*"/>
                    <DataGridTextColumn Header="Cycle" Binding="{Binding CycleText}"  Width="80" SortMemberPath="CycleMs"/>
                    <DataGridTextColumn Header="Count" Binding="{Binding Count}"      Width="80"/>
                </DataGrid.Columns>

                <!-- Row details: vertical signal table -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFF8E0" Padding="10,6" Margin="40,2,10,4"
                                BorderBrush="#FFE0D080" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Decoded signals" FontWeight="Bold" FontSize="11"
                                           Foreground="#FF806000" Margin="0,0,0,4"/>
                                <DataGrid ItemsSource="{Binding DecodedRows}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0" Background="#FFFFFDF5"
                                          FontFamily="Consolas" FontSize="12"
                                          MaxHeight="280" CanUserSortColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Signal" Binding="{Binding Name}"  Width="260"/>
                                        <DataGridTextColumn Header="Value"  Binding="{Binding Value}" Width="160"/>
                                        <DataGridTextColumn Header="Unit"   Binding="{Binding Unit}"  Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                </DataGrid>
                </Grid>
        </Grid>
    </DockPanel>
</Window>
