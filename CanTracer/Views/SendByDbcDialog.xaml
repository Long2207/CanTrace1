<Window x:Class="CanTracer.Views.SendByDbcDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send by DBC Signal" Height="640" Width="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="14">

        <!-- TOP: bus + message picker =======================================-->
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Bus:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox  x:Name="BusBox" Grid.Row="0" Grid.Column="1" Margin="0,4"
                       DisplayMemberPath="Name" SelectionChanged="OnBusChanged"/>

            <TextBlock Text="Search msg:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox   x:Name="SearchBox" Grid.Row="1" Grid.Column="1" Margin="0,4"
                       TextChanged="OnSearchChanged"
                       ToolTip="Type message name or ID hex to filter the list below"/>

            <TextBlock Text="Message:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox  x:Name="MsgBox" Grid.Row="2" Grid.Column="1" Margin="0,4"
                       MaxDropDownHeight="320"
                       SelectionChanged="OnMessageChanged"/>
        </Grid>

        <!-- MIDDLE: signal editor (one row per signal) ======================-->
        <Border DockPanel.Dock="Top" BorderThickness="0,1,0,1" BorderBrush="#FFD0D0D0"
                Margin="0,10,0,8" Padding="0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Signals" FontWeight="Bold"
                           FontSize="11" Foreground="#FF555555" Margin="0,0,0,6"/>
                <ScrollViewer x:Name="SignalScroll" VerticalScrollBarVisibility="Auto"
                              MaxHeight="280">
                    <ItemsControl x:Name="SignalItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <TextBox   Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                               Grid.Column="1" Margin="4,0"/>
                                    <TextBlock Text="{Binding Unit}" Grid.Column="2"
                                               VerticalAlignment="Center" Foreground="#FF777777"/>
                                    <TextBlock Text="{Binding Range}" Grid.Column="3"
                                               VerticalAlignment="Center" Foreground="#FF999999" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- BOTTOM: preview + cyclic + send buttons =========================-->
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Encoded data:" Grid.Row="0" Grid.Column="0"
                       VerticalAlignment="Center" Margin="0,8,0,4"/>
            <TextBlock x:Name="PreviewBlock" Grid.Row="0" Grid.Column="1"
                       FontFamily="Consolas" FontSize="13" Margin="0,8,0,4"/>

            <CheckBox  x:Name="CyclicBox" Content="Cyclic" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

            <TextBlock Text="Period (ms):" Grid.Row="2" Grid.Column="0"
                       VerticalAlignment="Center" Margin="0,4"/>
            <TextBox   x:Name="PeriodBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Width="120"
                       HorizontalAlignment="Left" Text="100"/>

            <TextBlock x:Name="StatusBlock" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                       Foreground="DarkRed" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Send once"  Width="100" Margin="0,0,8,0" Click="OnSendOnce" IsDefault="True"/>
                <Button Content="Start cyclic" Width="100" Margin="0,0,8,0" Click="OnStartCyclic"/>
                <Button Content="Close"      Width="80"                   Click="OnClose" IsCancel="True"/>
            </StackPanel>
        </Grid>

    </DockPanel>
</Window>
