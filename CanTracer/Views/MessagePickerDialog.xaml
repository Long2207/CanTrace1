<Window x:Class="CanTracer.Views.MessagePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a message" Height="500" Width="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12">

    <DockPanel Margin="14">

        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="Bold"
                   Margin="0,0,0,8" TextWrapping="Wrap"/>

        <!-- Manual entry -->
        <Border DockPanel.Dock="Top" BorderThickness="1" BorderBrush="#FFE0E0E0"
                CornerRadius="4" Padding="10" Margin="0,0,0,10" Background="#FFFAFAFA">
            <StackPanel>
                <TextBlock Text="Type an ID or name (then OK)" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="ManualBox" Padding="4" VerticalContentAlignment="Center"
                         ToolTip="e.g. 0x488 or ACM_WarnMsg"/>
            </StackPanel>
        </Border>

        <!-- Bottom buttons -->
        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="80" Padding="0,5" Margin="0,0,8,0"
                        Click="OnOk" IsDefault="True"/>
                <Button Content="Cancel" Width="80" Padding="0,5" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- DBC list -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Or pick from the DBC of this bus"
                       FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Padding="4" Margin="0,0,0,6"
                     VerticalContentAlignment="Center" TextChanged="OnFilterChanged"
                     ToolTip="Filter the list"/>
            <ListBox x:Name="DbcList" SelectionMode="Single"
                     MouseDoubleClick="OnListDoubleClick"/>
        </DockPanel>

    </DockPanel>
</Window>
